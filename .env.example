# Copy this file to .env and replace values for your local environment.
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = kost_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Generate a private key for each environment; do not commit the generated value.
# Example command: php spark key:generate
encryption.key = replace_this_with_a_private_key
